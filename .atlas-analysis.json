  "keyFeatures": [
    "Reality Engine — daily board of model-vs-market probability disagreements across MLB, NFL, and more",
    "Timestamped, immutable forecast issuance with full provenance and contract evidence",
    "Graded record that always includes misses — never filtered or cherry-picked",
    "Quant Partner API with Bearer-key authentication and opaque-cursor pagination",
    "Bulk JSON/CSV export of forecasts and grades (up to 50,000 rows)",
    "Per-family model history with Brier scores and expected vs. actual win aggregates",
    "OpenAPI 3.0 contract available publicly at /api/v1/openapi.json",
    "Customer-specific API keys — independently rate-limited and revocable"
  ],
  "publicApiSurface": [
    "GET /api/v1/manifest",
